# Copy to .env.local (gitignored — "*.local" is in .gitignore) and fill in.
# See docs/plans/phase4-execution-plan.md §5 for the full wiring sequence.

# Convex deployment selector for the CLI (form: dev:<deployment-name>).
CONVEX_DEPLOYMENT=

# Public HTTP endpoint of the Convex deployment — baked into the browser
# build at compile time (also set in Vercel for production).
VITE_CONVEX_SITE_URL=

# NOT here: GEMINI_API_KEY. The runtime copy lives in Convex env vars
# (npx convex env set GEMINI_API_KEY <value>) and is read only inside the
# Convex action. The local seed script takes it from the shell environment.
